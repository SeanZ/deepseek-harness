diff --git a/b/tests/client-bundle.spec.mjs b/tests/client-bundle.spec.mjs
new file mode 100644
index 0000000000..93920bcb0f
--- /dev/null
+++ b/tests/client-bundle.spec.mjs
@@ -0,0 +1,93 @@
+import assert from 'node:assert/strict'
+import test from 'node:test'
+import vm from 'node:vm'
+import { readFileSync } from 'node:fs'
+
+// 在独立 VM 里运行交付 bundle，验证真实注册入口和异步卸载，不连接用户实例。
+function harness({ pending = false } = {}) {
+  let plugin, options, component, face, invalidation, settingsListener
+  const disposers = [], styles = new Set(), calls = [], resolvers = []
+  let value = { enabled: true, targetPresets: ['creative'], includeSubagents: false }
+  const document = {
+    querySelector: () => styles.values().next().value ?? null,
+    createElement: () => { const tag = { dataset: {}, remove: () => styles.delete(tag) }; return tag },
+    head: { appendChild: tag => styles.add(tag) },
+  }
+  const ctx = {
+    get: () => ({ rpc: { call: async (...args) => {
+      calls.push(args)
+      if (pending) await new Promise(resolve => resolvers.push(resolve))
+      return { ok: true, value: { ...value, compatible: true, requestInjectionsVersion: 2 } }
+    } } }),
+    effect: factory => { const off = factory(); if (off) disposers.push(off) },
+    locale: { register: () => () => {} },
+    settingsScope: { bind: () => ({
+      getSnapshot: () => ({ value, writable: true, status: 'ready' }),
+      set: async (key, v) => { value = { ...value, [key]: v }; settingsListener?.() },
+      subscribe: callback => { settingsListener = callback; return () => { settingsListener = undefined } },
+    }) },
+    remote: { $on: (_event, cb) => { invalidation = cb; return () => { invalidation = undefined } } },
+    slots: {
+      inject: (slot, factory) => { assert.equal(slot, 'plugins.bundle.config'); const off = factory(); if (off) disposers.push(off) },
+      register: (opts, c) => { options = opts; component = c; face = opts.inject(); return () => { face = undefined } },
+    },
+  }
+  const jsx = (type, props) => ({ type, props })
+  vm.runInNewContext(readFileSync(process.env.UNRESTRICTED_CLIENT_BUNDLE ?? new URL('../lib/client.js', import.meta.url), 'utf8'), {
+    document, window: { __ModuleLoader__: { load: ({ factory }) => { plugin = factory(() => ({ jsx, jsxs: jsx })) } } },
+  })
+  plugin.apply(ctx)
+  return {
+    options, component, face, calls, styles,
+    invalidate: () => invalidation?.('unrestricted'),
+    resolve: () => resolvers.splice(0).forEach(resolve => resolve()),
+    dispose: () => disposers.reverse().forEach(off => off()),
+  }
+}
+const settle = async () => { for (let i = 0; i < 8; i++) await Promise.resolve() }
+
+test('制品注册外部 bundle 配置页，默认展开，卸载释放样式与订阅', async () => {
+  const h = harness()
+  try {
+    await settle()
+    assert.equal(h.options.name, 'plugins.bundle.config')
+    assert.equal(h.options.key, 'dsh-unrestricted')
+    assert.equal(h.styles.size, 1)
+    const output = h.component({ ...h.face, t: key => key, useView: read => read(h.face.hooks.view.getSnapshot()) })
+    assert.equal(output.type, 'details')
+    assert.equal(output.props.open, true)
+  } finally { h.dispose() }
+  assert.equal(h.styles.size, 0)
+  const count = h.calls.length
+  h.invalidate()
+  await settle()
+  assert.equal(h.calls.length, count)
+})
+
+test('设置提交后立即刷新共享状态，默认子Agent排除保持不变', async () => {
+  const h = harness()
+  try {
+    await settle()
+    await h.face.setEnabled(false)
+    const view = h.face.hooks.view.getSnapshot()
+    assert.equal(view.enabled, false)
+    assert.equal(view.status.enabled, false)
+    assert.equal(view.includeSubagents, false)
+    assert.equal(h.calls.at(-1)[0], '/api')
+    assert.equal(h.calls.at(-1)[1], 'unrestricted/status')
+  } finally { h.dispose() }
+})
+
+test('卸载后迟到的状态响应不再写入旧视图', async () => {
+  const h = harness({ pending: true })
+  const view = h.face.hooks.view
+  const before = view.getSnapshot()
+  let notifications = 0
+  view.subscribe(() => notifications++)
+  h.dispose()
+  h.resolve()
+  await settle()
+  assert.equal(view.getSnapshot(), before)
+  assert.equal(notifications, 0)
+  assert.equal(h.styles.size, 0)
+})
