diff --git a/b/tests/node.spec.mjs b/tests/node.spec.mjs
new file mode 100644
index 0000000000..e4cc48ad42
--- /dev/null
+++ b/tests/node.spec.mjs
@@ -0,0 +1,107 @@
+import assert from 'node:assert/strict'
+import test from 'node:test'
+import { apply } from '../src/node.js'
+import { INJECTION_KEY } from '../src/rules.js'
+
+function harness(initial = {}) {
+  let value = {
+    enabled: true,
+    targetPresets: ['creative'],
+    includeSubagents: false,
+    ...initial,
+  }
+  let watch
+  let listener
+  let statusRoute
+  const ctx = {
+    agentLoop: { requestInjectionsVersion: 2 },
+    settings: {
+      register: () => ({
+        get: () => value,
+        watch: callback => {
+          watch = callback
+          return () => {}
+        },
+      }),
+    },
+    agentPresets: { composedPreset: agentCtx => agentCtx.preset },
+    on: (name, callback) => {
+      if (name === 'agent/request-injections') listener = callback
+    },
+    effect: factory => { factory() },
+    inject: (_services, callback) => callback({
+      connection: { fetch: { register: (route) => {
+        statusRoute = route
+        return () => {}
+      } } },
+    }),
+  }
+  apply(ctx)
+  return {
+    statusRoute: () => statusRoute,
+    request: (preset, header = {}, downstream = []) => listener(
+      { agent: { ctx: { preset }, session: { header } } },
+      () => Promise.resolve(downstream),
+    ),
+    update(next) {
+      value = { ...value, ...next }
+      watch(value)
+    },
+  }
+}
+
+test('host contributes only to a targeted creative agent and preserves downstream order', async () => {
+  const host = harness()
+  const prior = {
+    key: 'prior', role: 'assistant', text: 'prior',
+    source: { kind: 'plugin', plugin: 'prior' },
+    placement: { kind: 'depth', depth: 0 },
+  }
+  assert.deepEqual(await host.request('standard', {}, [prior]), [prior])
+  const creative = await host.request('creative', {}, [prior])
+  assert.equal(creative.length, 2)
+  assert.equal(creative[0], prior)
+  assert.equal(creative[1].key, INJECTION_KEY)
+  assert.equal(creative[1].role, 'assistant')
+  assert.deepEqual(creative[1].placement, { kind: 'before-latest-user' })
+})
+
+test('settings changes take effect at the next request boundary', async () => {
+  const host = harness()
+  assert.equal((await host.request('creative')).length, 1)
+  host.update({ enabled: false })
+  assert.deepEqual(await host.request('creative'), [])
+  host.update({ enabled: true, targetPresets: ['story'] })
+  assert.deepEqual(await host.request('creative'), [])
+  assert.deepEqual((await host.request('story'))[0].placement, { kind: 'before-latest-user' })
+})
+
+test('subagent targeting stays opt-in', async () => {
+  const host = harness()
+  assert.deepEqual(await host.request('creative', { origin: 'subagent' }), [])
+  host.update({ includeSubagents: true })
+  assert.equal((await host.request('creative', { origin: 'subagent' })).length, 1)
+})
+
+test('fails loud when the DSH core lacks the request-injection protocol', () => {
+  assert.throws(() => apply({ agentLoop: {}, settings: {} }), /requestInjectionsVersion=2/)
+})
+
+
+test('状态通过共享 API 返回完整 RPC 响应，设置更新即时可见', async () => {
+  const host = harness()
+  const route = host.statusRoute()
+  assert.equal(route.path, '/api/unrestricted/status')
+  assert.deepEqual(route.methods, ['POST'])
+  assert.equal(route.requestBody, 'buffered')
+  const call = () => route.fetch(new Request('http://localhost/api/unrestricted/status', {
+    method: 'POST', body: JSON.stringify({ rpcId: 'status-test' }),
+  })).then(response => response.json())
+  const first = await call()
+  assert.equal(first.type, 'server-response')
+  assert.equal(first.rpcId, 'status-test')
+  assert.equal(first.result.value.compatible, true)
+  assert.equal(first.result.value.enabled, true)
+  host.update({ enabled: false })
+  assert.equal((await call()).result.value.enabled, false)
+})
diff --git a/b/tests/rules.spec.mjs b/tests/rules.spec.mjs
