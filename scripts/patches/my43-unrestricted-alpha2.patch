-{"version":3,"file":"client.js","names":[],"sources":["../src/client/controller.ts","../src/client/locales.ts","../src/client/styles.ts","../src/client/UnrestrictedCard.tsx","../src/client/index.tsx"],"sourcesContent":["/** Browser controller for the preset-scoped creative-injection settings card. */\nimport type { Context } from '@deepseek-ai/cordis'\nimport type { ConnectionHandle } from '@deepseek-ai/dsh-client-connection/client'\nimport type {} from '@deepseek-ai/dsh-api-remotes/client'\nimport type {} from '@deepseek-ai/dsh-client-ui-settings/client'\n\nexport interface UnrestrictedSettings {\n  enabled?: boolean\n  targetPresets?: string[]\n  includeSubagents?: boolean\n}\n\nexport interface UnrestrictedStatus {\n  compatible: boolean\n  requestInjectionsVersion: number\n  enabled: boolean\n  targetPresets: string[]\n  includeSubagents: boolean\n}\n\nexport interface UnrestrictedViewSnapshot {\n  enabled: boolean\n  targetPresets: string[]\n  includeSubagents: boolean\n  writable: boolean\n  settingsStatus: 'loading' | 'ready' | 'unavailable'\n  status: UnrestrictedStatus | null\n  message?: string\n}\n\ntype RpcResult<T> = { ok: true; value: T } | { ok: false; error: { code: string; message: string } }\n\nexport interface UnrestrictedViewSource {\n  getSnapshot(): UnrestrictedViewSnapshot\n  subscribe(listener: () => void): () => void\n}\n\nexport interface UnrestrictedCardInjected {\n  hooks: { view: UnrestrictedViewSource }\n  setEnabled: (enabled: boolean) => Promise<void>\n  setTargetPresets: (targetPresets: string[]) => Promise<void>\n  setIncludeSubagents: (includeSubagents: boolean) => Promise<void>\n  refresh: () => Promise<void>\n}\n\nconst RPC_CHANNEL = '/api'\nconst SETTINGS_NS = 'unrestricted'\n\nconst messageOf = (error: unknown): string => error instanceof Error ? error.message : String(error)\n\nexport function createUnrestrictedController(ctx: Context) {\n  const connection = ctx.get('connection') as ConnectionHandle\n  const settings = ctx.settingsScope.bind<UnrestrictedSettings>({ namespace: SETTINGS_NS })\n  let snapshot: UnrestrictedViewSnapshot = {\n    enabled: false,\n    targetPresets: ['creative'],\n    includeSubagents: false,\n    writable: false,\n    settingsStatus: 'loading',\n    status: null,\n  }\n  const listeners = new Set<() => void>()\n  const view: UnrestrictedViewSource = {\n    getSnapshot: () => snapshot,\n    subscribe(listener) {\n      listeners.add(listener)\n      return () => listeners.delete(listener)\n    },\n  }\n\n  function publish(): void {\n    const current = settings.getSnapshot()\n    snapshot = {\n      enabled: current.value?.enabled === true,\n      targetPresets: current.value?.targetPresets ?? ['creative'],\n      includeSubagents: current.value?.includeSubagents === true,\n      writable: current.writable,\n      settingsStatus: current.status,\n      status: snapshot.status,\n      message: snapshot.message,\n    }\n    for (const listener of listeners) listener()\n  }\n\n  async function call<T>(endpoint: string): Promise<T> {\n    const result = await connection.rpc.call(RPC_CHANNEL, `unrestricted/${endpoint}`, {}) as RpcResult<T>\n    if (!result.ok) throw new Error(result.error.message)\n    return result.value\n  }\n\n  async function refresh(): Promise<void> {\n    try {\n      snapshot = { ...snapshot, status: await call<UnrestrictedStatus>('status'), message: undefined }\n    } catch (error) {\n      snapshot = { ...snapshot, message: messageOf(error) }\n    }\n    publish()\n  }\n\n  async function setValue<K extends keyof UnrestrictedSettings>(\n    key: K,\n    value: NonNullable<UnrestrictedSettings[K]>,\n  ): Promise<void> {\n    await settings.set(key, value)\n    publish()\n    setTimeout(() => void refresh(), 300)\n  }\n\n  ctx.effect(() => settings.subscribe(publish), 'dsh-unrestricted: settings mirror')\n  ctx.effect(\n    () => ctx.remote.$on('settings/document-updated', (namespace?: string) => {\n      if (namespace === undefined || namespace === SETTINGS_NS) void refresh()\n    }),\n    'dsh-unrestricted: settings invalidations',\n  )\n\n  publish()\n  void refresh()\n  return {\n    face: (): UnrestrictedCardInjected => ({\n      hooks: { view },\n      setEnabled: value => setValue('enabled', value),\n      setTargetPresets: value => setValue('targetPresets', value),\n      setIncludeSubagents: value => setValue('includeSubagents', value),\n      refresh,\n    }),\n  }\n}\n","/** Copy dictionaries for the creative assistant-injection card. */\nexport const zh = {\n  title: '勇于创作',\n  summaryEnabled: '已对目标 Agent 开启',\n  summaryDisabled: '已关闭',\n  summaryLoading: '读取中',\n  summaryUnavailable: '设置不可用',\n  description: '以可回放的 assistant 消息注入创作语境，不改写 DSH 系统提示词。默认只作用于 creative 预设，Standard 等其他 Agent 保持原样。',\n  toggle: '启用创作注入',\n  targetPresets: '目标预设（逗号分隔）',\n  includeSubagents: '同时作用于子代理',\n  ageSemantics: '“18+”只表示内容分级语境，不会给角色设定年龄、改龄或在正文中强调成年化。',\n  scopeNote: '只改变目标 Agent 发给模型的消息；不改变工具、权限、沙箱或 Agent 工作流。',\n  refresh: '刷新状态',\n  settingsUnavailable: '当前连接不可写设置（远程浏览器只读）。',\n  operationFailed: '操作失败：',\n} satisfies Record<string, string>\n\nexport type UnrestrictedLocaleKey = keyof typeof zh\n\nexport const en = {\n  title: 'Creative mode',\n  summaryEnabled: 'Enabled for target agents',\n  summaryDisabled: 'Disabled',\n  summaryLoading: 'Loading',\n  summaryUnavailable: 'Settings unavailable',\n  description: 'Injects replayable assistant-role creative context without rewriting DSH system prompts. It targets only the creative preset by default; Standard and other agents stay unchanged.',\n  toggle: 'Enable creative injection',\n  targetPresets: 'Target presets (comma-separated)',\n  includeSubagents: 'Also apply to subagents',\n  ageSemantics: '“18+” classifies the content context only; it never assigns or changes character ages or advertises an age-up in the prose.',\n  scopeNote: 'Only target-agent model messages change. Tools, permissions, sandboxing, and agent workflow do not.',\n  refresh: 'Refresh status',\n  settingsUnavailable: 'This connection cannot write settings (remote browser is read-only).',\n  operationFailed: 'Operation failed: ',\n} satisfies Record<UnrestrictedLocaleKey, string>\n\nexport const NS = 'settings.unrestricted'\n","/**\n * Stylesheet for the unrestricted settings card. One hand-written stylesheet\n * injected as a single <style data-plugin> tag (the loader convention for\n * plugin-owned styles); colors come from the shared --dsw-* tokens.\n */\n\nconst CSS = `\n.dsh-unrestricted-card {\n  display: block;\n  width: 100%;\n  max-width: 760px;\n  box-sizing: border-box;\n  border: 1px solid var(--dsw-alias-border-l2);\n  border-radius: 10px;\n  overflow: hidden;\n  background: var(--dsw-alias-bg-layer-3);\n  color: var(--dsw-alias-label-primary);\n}\n\n.dsh-unrestricted-summary {\n  display: flex;\n  min-height: 48px;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  box-sizing: border-box;\n  padding: 12px 14px;\n  cursor: pointer;\n  list-style: none;\n  touch-action: manipulation;\n  user-select: none;\n}\n\n.dsh-unrestricted-summary::-webkit-details-marker { display: none; }\n\n.dsh-unrestricted-summary:hover { background: var(--dsw-alias-interactive-bg-hover); }\n\n.dsh-unrestricted-summary:focus-visible {\n  outline: 2px solid var(--dsw-alias-state-business-primary);\n  outline-offset: -2px;\n}\n\n.dsh-unrestricted-summary::after {\n  width: 8px;\n  height: 8px;\n  flex: none;\n  border-right: 2px solid var(--dsw-alias-label-tertiary);\n  border-bottom: 2px solid var(--dsw-alias-label-tertiary);\n  content: '';\n  transform: rotate(45deg);\n  transition: transform 160ms ease;\n}\n\n.dsh-unrestricted-card[open] > .dsh-unrestricted-summary {\n  border-bottom: 1px solid var(--dsw-alias-border-l2);\n}\n\n.dsh-unrestricted-card[open] > .dsh-unrestricted-summary::after {\n  transform: rotate(225deg);\n}\n\n.dsh-unrestricted-summaryText {\n  display: flex;\n  min-width: 0;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 8px;\n}\n\n.dsh-unrestricted-summaryStatus {\n  border: 1px solid var(--dsw-alias-border-l2);\n  border-radius: 999px;\n  padding: 1px 7px;\n  background: var(--dsw-alias-bg-layer-2);\n  color: var(--dsw-alias-label-tertiary);\n  font-size: 12px;\n  line-height: 18px;\n}\n\n.dsh-unrestricted-summaryStatus[data-state='active'] {\n  color: var(--dsw-alias-state-success-primary);\n}\n\n.dsh-unrestricted-summaryStatus[data-state='pending'] {\n  color: var(--dsw-alias-state-business-primary);\n}\n\n.dsh-unrestricted-summaryStatus[data-state='error'] {\n  color: var(--dsw-alias-state-error-primary);\n}\n\n.dsh-unrestricted-content {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n  padding: 14px;\n}\n\n.dsh-unrestricted-title {\n  margin: 0;\n  font-size: 14px;\n  line-height: 20px;\n  font-weight: 600;\n}\n\n.dsh-unrestricted-statusTitle {\n  margin: 4px 0 0;\n  font-size: 13px;\n  line-height: 18px;\n  font-weight: 600;\n}\n\n.dsh-unrestricted-description,\n.dsh-unrestricted-note {\n  margin: 0;\n  font-size: 13px;\n  line-height: 20px;\n  color: var(--dsw-alias-label-tertiary);\n}\n\n.dsh-unrestricted-note {\n  font-size: 12px;\n  line-height: 18px;\n}\n\n.dsh-unrestricted-error {\n  margin: 0;\n  border: 1px solid var(--dsw-alias-state-error-primary);\n  border-radius: 8px;\n  padding: 8px 12px;\n  color: var(--dsw-alias-state-error-primary);\n  font-size: 13px;\n  line-height: 20px;\n  overflow-wrap: anywhere;\n}\n\n.dsh-unrestricted-toggle {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  color: var(--dsw-alias-label-secondary);\n  font-size: 13px;\n  cursor: pointer;\n  user-select: none;\n}\n\n.dsh-unrestricted-toggle input {\n  accent-color: var(--dsw-alias-state-business-primary);\n}\n\n.dsh-unrestricted-field {\n  display: grid;\n  grid-template-columns: minmax(180px, 1fr) minmax(180px, 2fr);\n  align-items: center;\n  gap: 10px;\n  color: var(--dsw-alias-label-secondary);\n  font-size: 13px;\n}\n\n.dsh-unrestricted-field input {\n  min-width: 0;\n  border: 1px solid var(--dsw-alias-border-l2);\n  border-radius: 6px;\n  padding: 5px 8px;\n  background: var(--dsw-alias-bg-layer-2);\n  color: var(--dsw-alias-label-primary);\n  font: inherit;\n}\n\n.dsh-unrestricted-modes {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.dsh-unrestricted-mode {\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 8px;\n  font-size: 13px;\n  line-height: 18px;\n}\n\n.dsh-unrestricted-dot {\n  display: inline-block;\n  width: 7px;\n  height: 7px;\n  flex: none;\n  border-radius: 999px;\n  background: var(--dsw-alias-label-tertiary);\n}\n\n.dsh-unrestricted-dot[data-state='active'] {\n  background: var(--dsw-alias-state-success-primary);\n}\n\n.dsh-unrestricted-dot[data-state='checking'] {\n  background: var(--dsw-alias-state-business-primary);\n}\n\n.dsh-unrestricted-dot[data-state='failed'] {\n  background: var(--dsw-alias-state-error-primary);\n}\n\n.dsh-unrestricted-modeName {\n  color: var(--dsw-alias-label-primary);\n}\n\n.dsh-unrestricted-modeState {\n  color: var(--dsw-alias-label-secondary);\n}\n\n.dsh-unrestricted-issues {\n  flex-basis: 100%;\n  padding-left: 15px;\n  color: var(--dsw-alias-state-error-primary);\n  font-size: 12px;\n  line-height: 18px;\n  overflow-wrap: anywhere;\n}\n\n.dsh-unrestricted-actions {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.dsh-unrestricted-actions button {\n  border: 1px solid var(--dsw-alias-border-l2);\n  border-radius: 6px;\n  padding: 4px 12px;\n  background: transparent;\n  color: var(--dsw-alias-label-primary);\n  font: inherit;\n  font-size: 13px;\n  cursor: pointer;\n}\n\n.dsh-unrestricted-actions button:hover:not(:disabled) {\n  background: var(--dsw-alias-interactive-bg-hover);\n}\n\n.dsh-unrestricted-actions button:focus-visible {\n  outline: 2px solid var(--dsw-alias-state-business-primary);\n  outline-offset: 2px;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .dsh-unrestricted-summary::after { transition: none; }\n}\n`\n\n/** Inject the stylesheet once; the tag id doubles as the re-evaluation guard. */\nexport function ensureStyles(): void {\n  if (typeof document === 'undefined') return\n  if (document.querySelector('style[data-plugin=\"dsh-unrestricted\"]') !== null) return\n  const tag = document.createElement('style')\n  tag.dataset.plugin = 'dsh-unrestricted'\n  tag.textContent = CSS\n  document.head.appendChild(tag)\n}\n","/** Settings card for the preset-scoped assistant request injection. */\nimport type { InjectFace, PropsLocale, PropsRuntime } from '@deepseek-ai/dsh-client-ui-slots'\nimport type {} from '@deepseek-ai/dsh-client-ui-settings-plugins/client'\nimport type { UnrestrictedCardInjected } from './controller.ts'\nimport type { UnrestrictedLocaleKey } from './locales.ts'\n\nexport type UnrestrictedCardProps =\n  PropsRuntime<'settings.plugin.item'>\n  & PropsLocale<'settings.unrestricted'>\n  & InjectFace<UnrestrictedCardInjected>\n\nfunction parsePresets(value: string): string[] {\n  return [...new Set(value.split(',').map(item => item.trim()).filter(Boolean))]\n}\n\nexport function UnrestrictedCard(props: UnrestrictedCardProps) {\n  const { t } = props\n  const view = props.useView(snapshot => snapshot)\n  const active = view.enabled && view.status?.compatible === true\n  const summaryKey: UnrestrictedLocaleKey = view.settingsStatus === 'loading'\n    ? 'summaryLoading'\n    : view.settingsStatus === 'unavailable'\n      ? 'summaryUnavailable'\n      : active ? 'summaryEnabled' : 'summaryDisabled'\n  const disabled = !view.writable || view.settingsStatus !== 'ready'\n  return (\n    <details className=\"dsh-unrestricted-card\">\n      <summary className=\"dsh-unrestricted-summary\">\n        <span className=\"dsh-unrestricted-summaryText\">\n          <span className=\"dsh-unrestricted-title\" role=\"heading\" aria-level={3}>{t('title')}</span>\n          <span className=\"dsh-unrestricted-summaryStatus\" data-state={active ? 'active' : 'off'}>{t(summaryKey)}</span>\n        </span>\n      </summary>\n      <div className=\"dsh-unrestricted-content\">\n        <p className=\"dsh-unrestricted-description\">{t('description')}</p>\n        <label className=\"dsh-unrestricted-toggle\">\n          <input\n            type=\"checkbox\"\n            checked={view.enabled}\n            disabled={disabled}\n            onChange={event => { void props.setEnabled(event.target.checked) }}\n          />\n          <span>{t('toggle')}</span>\n        </label>\n        <label className=\"dsh-unrestricted-field\">\n          <span>{t('targetPresets')}</span>\n          <input\n            key={view.targetPresets.join(',')}\n            type=\"text\"\n            defaultValue={view.targetPresets.join(', ')}\n            disabled={disabled}\n            onBlur={event => { void props.setTargetPresets(parsePresets(event.target.value)) }}\n          />\n        </label>\n        <label className=\"dsh-unrestricted-toggle\">\n          <input\n            type=\"checkbox\"\n            checked={view.includeSubagents}\n            disabled={disabled}\n            onChange={event => { void props.setIncludeSubagents(event.target.checked) }}\n          />\n          <span>{t('includeSubagents')}</span>\n        </label>\n        <p className=\"dsh-unrestricted-note\">{t('ageSemantics')}</p>\n        <p className=\"dsh-unrestricted-note\">{t('scopeNote')}</p>\n        {view.settingsStatus === 'unavailable' && <p className=\"dsh-unrestricted-note\">{t('settingsUnavailable')}</p>}\n        {view.message !== undefined && <p className=\"dsh-unrestricted-error\">{t('operationFailed')}{view.message}</p>}\n        <div className=\"dsh-unrestricted-actions\">\n          <button type=\"button\" onClick={() => { void props.refresh() }}>{t('refresh')}</button>\n        </div>\n      </div>\n    </details>\n  )\n}\n","/** Unrestricted mode browser half: one keyed card in the plugin-configuration tab. */\nimport type {} from '@deepseek-ai/dsh-client-locale/client'\nimport type {} from '@deepseek-ai/dsh-client-ui-settings/client'\n// Type-only: the renderer provides the ctx.slots service used for registration.\nimport type {} from '@deepseek-ai/dsh-client-ui-renderer/client'\n// Type-only: the `settings.plugin.item` keyed slot declaration this card registers into.\nimport type {} from '@deepseek-ai/dsh-client-ui-settings-plugins/client'\nimport type { Context } from '@deepseek-ai/cordis'\nimport { createUnrestrictedController } from './controller.ts'\nimport { en, NS, zh, type UnrestrictedLocaleKey } from './locales.ts'\nimport { ensureStyles } from './styles.ts'\nimport { UnrestrictedCard } from './UnrestrictedCard.tsx'\n\ndeclare module '@deepseek-ai/dsh-client-ui-slots' {\n  interface LocaleNamespaceMap {\n    /** Unrestricted mode copy. */\n    'settings.unrestricted': UnrestrictedLocaleKey\n  }\n}\n\n/** Services required by the registration and the controller. */\nexport const inject = ['slots', 'locale', 'connection', 'remote', 'settingsScope']\n\n/** Contribute the unrestricted card to the plugin-configuration tab. */\nexport function apply(ctx: Context): void {\n  ensureStyles()\n  ctx.effect(() => ctx.locale.register(NS, { zh, en }), 'dsh-unrestricted: dictionaries')\n  const controller = createUnrestrictedController(ctx)\n  ctx.slots.inject('settings.plugin.item', () => ctx.slots.register({\n    name: 'settings.plugin.item',\n    key: 'unrestricted',\n    locale: NS,\n    inject: () => controller.face(),\n  }, UnrestrictedCard))\n}\n"],"mappings":";;;;;;;;EA6CA,MAAM,cAAc;EACpB,MAAM,cAAc;EAEpB,MAAM,aAAa,UAA2B,iBAAiB,QAAQ,MAAM,UAAU,OAAO,KAAK;EAEnG,SAAgB,6BAA6B,KAAc;GACzD,MAAM,aAAa,IAAI,IAAI,YAAY;GACvC,MAAM,WAAW,IAAI,cAAc,KAA2B,EAAE,WAAW,YAAY,CAAC;GACxF,IAAI,WAAqC;IACvC,SAAS;IACT,eAAe,CAAC,UAAU;IAC1B,kBAAkB;IAClB,UAAU;IACV,gBAAgB;IAChB,QAAQ;GACV;GACA,MAAM,4BAAY,IAAI,IAAgB;GACtC,MAAM,OAA+B;IACnC,mBAAmB;IACnB,UAAU,UAAU;KAClB,UAAU,IAAI