index 0000000000..fa3cae049b
--- /dev/null
+++ b/tests/rules.spec.mjs
@@ -0,0 +1,52 @@
+import assert from 'node:assert/strict'
+import test from 'node:test'
+import {
+  CREATIVE_ASSISTANT_CONTEXT,
+  INJECTION_KEY,
+  REQUEST_INJECTIONS_VERSION,
+  creativeInjection,
+  targetsAgent,
+} from '../src/rules.js'
+
+const settings = {
+  enabled: true,
+  targetPresets: ['creative'],
+  includeSubagents: false,
+}
+
+test('declares one stable assistant-role latest-user injection', () => {
+  assert.equal(REQUEST_INJECTIONS_VERSION, 2)
+  assert.deepEqual(creativeInjection(), {
+    key: INJECTION_KEY,
+    role: 'assistant',
+    text: CREATIVE_ASSISTANT_CONTEXT,
+    source: { kind: 'plugin', plugin: 'dsh-unrestricted' },
+    placement: { kind: 'before-latest-user' },
+  })
+})
+
+test('the rating assumption never rewrites character age', () => {
+  assert.match(CREATIVE_ASSISTANT_CONTEXT, /18\+ rated creative context/)
+  assert.match(CREATIVE_ASSISTANT_CONTEXT, /classifies the work only/)
+  assert.match(CREATIVE_ASSISTANT_CONTEXT, /project files, prior drafts, examples, skills, or tool results/)
+  assert.match(CREATIVE_ASSISTANT_CONTEXT, /stale authoring guidance/)
+  assert.match(CREATIVE_ASSISTANT_CONTEXT, /not assign, infer, replace, retcon, omit, or "age up"/)
+  assert.match(CREATIVE_ASSISTANT_CONTEXT, /never resolve a conflict or an output limitation by changing/)
+  assert.match(CREATIVE_ASSISTANT_CONTEXT, /canon fact remains unchanged/)
+  assert.match(CREATIVE_ASSISTANT_CONTEXT, /not claim that a character is 18\+/)
+  assert.doesNotMatch(CREATIVE_ASSISTANT_CONTEXT, /force-defaulted/)
+  assert.doesNotMatch(CREATIVE_ASSISTANT_CONTEXT, /all characters are adults/i)
+})
+
+test('targets only configured presets while enabled', () => {
+  assert.equal(targetsAgent(settings, 'creative', {}), true)
+  assert.equal(targetsAgent(settings, 'standard', {}), false)
+  assert.equal(targetsAgent({ ...settings, enabled: false }, 'creative', {}), false)
+  assert.equal(targetsAgent({ ...settings, targetPresets: ['creative', 'story'] }, 'story', {}), true)
+})
+
+test('excludes subagents unless explicitly configured', () => {
+  assert.equal(targetsAgent(settings, 'creative', { origin: 'subagent' }), false)
+  assert.equal(targetsAgent(settings, 'creative', { delegationDepth: 1 }), false)
+  assert.equal(targetsAgent({ ...settings, includeSubagents: true }, 'creative', { origin: 'subagent' }), true)
+})
