+test('状态通过共享 API 返回完整 RPC 响应，设置更新即时可见', async () => {
+  const host = harness()
+  const route = host.statusRoute()
+  assert.equal(route.path, '/api/unrestricted/status')
+  assert.deepEqual(route.methods, ['POST'])
+  assert.equal(route.requestBody, 'buffered')
+  const call = () => route.fetch(new Request('http://localhost/api/unrestricted/status', {
+    method: 'POST', body: JSON.stringify({ rpcId: 'status-test' }),
+  })).then(response => response.json())
+  const first = await call()
+  assert.equal(first.type, 'server-response')
+  assert.equal(first.rpcId, 'status-test')
+  assert.equal(first.result.value.compatible, true)
+  assert.equal(first.result.value.enabled, true)
+  host.update({ enabled: false })
+  assert.equal((await call()).result.value.enabled, false)
+})
