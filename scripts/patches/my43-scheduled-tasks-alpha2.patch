diff --git b/tests/alpha2-codecs.spec.mjs b/tests/alpha2-codecs.spec.mjs
new file mode 100644
index 0000000000..d588a0307d
--- /dev/null
+++ b/tests/alpha2-codecs.spec.mjs
@@ -0,0 +1,39 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { readFileSync } from 'node:fs'
+import { runInNewContext } from 'node:vm'
+import { Context } from '@deepseek-ai/cordis'
+import Registry from '@deepseek-ai/dsh-typert-registry'
+import { TYPERT } from '../lib/typert.js'
+import { TYPERT_REMOTE } from '../lib/client/typert-remote.js'
+
+function browserContribution() {
+ let exports
+ const path=process.env.SCHEDULED_CLIENT_BUNDLE??new URL('../lib/client.js',import.meta.url)
+ const code=readFileSync(path,'utf8').replace('exports.apply = apply;','exports.testContribution = TYPERT_REMOTE; exports.apply = apply;')
+ runInNewContext(code,{window:{__ModuleLoader__:{load({factory}){exports=factory(()=>({}))}}},console,TextEncoder,TextDecoder,URL,AbortController})
+ return exports.testContribution
+}
+
+for (const [name,contribution] of [['Host',TYPERT],['Client ESM',TYPERT_REMOTE],['发布浏览器 bundle',browserContribution()]]) {
+ test(`${name} 在 alpha2 注册并保留严格输入输出校验`,async()=>{
+  const ctx=new Context();await ctx.plugin(Registry)
+  try {
+   const dispose=name==='Host'?ctx.typert.register(contribution):ctx.typert.remotes.register(contribution)
+   const descriptors=contribution.descriptors??contribution.invocations
+   assert.equal(descriptors.length,7)
+   for(const descriptor of descriptors){
+    assert.equal(typeof descriptor.result.create,'function')
+    for(const parameter of descriptor.parameters){assert.equal(typeof parameter.codec.create,'function');assert.equal('schema' in parameter.codec,false)}
+   }
+   const list=descriptors.find(d=>d.method==='list')
+   assert.doesNotThrow(()=>list.parameters[0].codec.create().parse(undefined))
+   assert.throws(()=>list.parameters[0].codec.create().parse(42))
+   assert.doesNotThrow(()=>list.result.create().parse([]))
+   assert.throws(()=>list.result.create().parse([{id:42}]))
+   const create=descriptors.find(d=>d.method==='create')
+   assert.throws(()=>create.parameters[0].codec.create().parse({name:'缺少定时参数'}))
+   await dispose()
+  }finally{await ctx.fiber.dispose()}
+ })
+}
diff --git b/tests/alpha2-executor.spec.mjs b/tests/alpha2-executor.spec.mjs
new file mode 100644
index 0000000000..85597ad8c5
--- /dev/null
+++ b/tests/alpha2-executor.spec.mjs
@@ -0,0 +1,23 @@
+import assert from 'node:assert/strict'
+import {test} from 'node:test'
+const {TaskExecutor}=await import(process.env.SCHEDULED_EXECUTOR_MODULE??'../lib/executor.js')
+
+for(const fail of [false,true])test(`实时事件汇总并在${fail?'失败':'完成'}时移除观察者`,async()=>{
+ let observe;let detached=0;let idle=0
+ const session={id:'isolated-scheduled',seq:10,get events(){throw new Error('禁止读取旧 events 属性')}}
+ const agent={session,ctx:{on(name,callback){assert.equal(name,'session/event');observe=callback;return()=>{detached++;observe=undefined}}},
+  async whenIdle(){if(fail&&++idle===2)throw new Error('模拟执行失败')},
+  followup(message){
+   assert.equal(message.content[0].text,'只输出测试标记')
+   observe(session,{seq:9,type:'assistant/message',data:{message:{content:[{type:'text',text:'旧输出'}]}}})
+   observe(session,{seq:10,type:'assistant/message',data:{message:{content:[{type:'text',text:'测试标记'}]}}})
+   observe(session,{seq:11,type:'assistant/message',data:{message:{content:[]}}})
+   observe(session,{seq:12,type:'turn/end',data:{reason:{kind:'completed'}}})
+  }}
+ const ctx={get(name){if(name==='agents')return{async create(){return{agent}}};return undefined}}
+ const executor=new TaskExecutor(ctx,{}, {maxConcurrentRuns:1,runTimeoutMs:1000})
+ const result=await executor.driveAgent({projectPath:'/isolated',name:'测试',prompt:'只输出测试标记'},{provider:'fixture',model:'fixture'})
+ assert.equal(result.status,fail?'failed':'completed')
+ if(fail)assert.match(result.error,/模拟执行失败/);else assert.equal(result.output,'测试标记')
+ assert.equal(detached,1);assert.equal(observe,undefined)
+})
